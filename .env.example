# Copiar a .env.local y completar con los valores reales.
# .env.local esta en .gitignore; nunca commitear el archivo con valores reales.

# URL del proyecto Supabase (no es un secreto).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable de Supabase. Es segura para el cliente porque el acceso
# esta protegido por RLS. Si usas service_role, esa SI es un secreto: jamas
# la pongas en una variable EXPO_PUBLIC_* ni la subas al repositorio.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_TU_CLAVE

# Client ID de OAuth de Google (Web) desde Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# URL base de la app web. En produccion, reemplazar por la URL real
# (ej: https://mealprep.tudominio.com). En desarrollo local se puede dejar
# vacio para usar window.location.origin automaticamente.
# Debe estar en la whitelist de Supabase -> Authentication -> Redirect URLs.
# EXPO_PUBLIC_SITE_URL=