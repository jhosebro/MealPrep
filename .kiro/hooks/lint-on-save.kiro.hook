{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs expo lint automatically whenever a TypeScript or TSX file is saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run lint"
  },
  "workspaceFolderName": "MealPrep",
  "shortName": "lint-on-save"
}